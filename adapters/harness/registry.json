{
  "claude-code": {
    "command": "claude",
    "detect_args": ["--version"],
    "defaults": {
      "planning": { "model": "opus" },
      "research": { "model": "opus" },
      "research.subagent": { "model": "haiku" },
      "implementation": { "model": "sonnet" },
      "implementation.retry": { "model": "opus" },
      "review": { "model": "opus" }
    }
  },
  "opencode": { "command": "opencode", "detect_args": ["--version"], "default_model": "default" },
  "codex": { "command": "codex", "detect_args": ["--version"], "default_model": "default" }
}
