{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flow-review verdict (written to .flow/active/<slug>/tasks/<id>/verdict.json)",
  "type": "object",
  "required": ["verdict", "reviewed_commit", "violations"],
  "properties": {
    "verdict": { "enum": ["pass", "fail"], "description": "fail iff at least one violation has severity block" },
    "reviewed_commit": { "type": "string", "description": "HEAD sha that was reviewed; CI rejects the verdict if non-.flow files changed after it" },
    "reviewer": { "type": "object", "properties": { "harness": { "type": "string" }, "model": { "type": "string" } } },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "file", "why", "severity"],
        "properties": {
          "rule": { "type": "string", "description": "R-nnn, I-nnn, or SC-n" },
          "file": { "type": "string" },
          "why": { "type": "string" },
          "severity": { "enum": ["block", "ask", "log"] }
        }
      }
    }
  }
}
