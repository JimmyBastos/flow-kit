{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git restore *)",
      "Bash(git rev-parse *)",
      "Bash(git hash-object *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(printf *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(claude *)",
      "Bash(opencode *)",
      "Bash(orca *)",
      "Bash(git * --output*)",
      "Bash(git show *:.env*)",
      "Bash(git * --ext-diff*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.flow/**/spec.md)",
      "Edit(**/.flow/**/spec.md)",
      "Edit(./.flow/flow.json)",
      "Edit(**/.flow/flow.json)",
      "Edit(./.claude/**)",
      "Edit(**/.claude/**)"
    ]
  }
}
